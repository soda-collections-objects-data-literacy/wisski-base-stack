# General settings
DEBUG=true
MODE=production
SERVICE_NAME=wisski-base-stack
WISSKI_BASE_IMAGE_VERSION=latest
SHARED_DATA_VOLUME=scs--shared-data

# Adminer settings
ADMINER_PORT=8081

# Database settings
DB_PORT=3306
DB_DRIVER=mysql
DB_HOST=mariadb
DB_NAME=DATABASE
DB_USER=DBUSER
DB_PASSWORD=USERPW
DB_ROOT_PASSWORD=ROOTPW

# Drupal settings
DRUPAL_DOMAIN=localhost
DRUPAL_LOCALE=en
DRUPAL_PASSWORD=admin
DRUPAL_PORT=80
DRUPAL_SITE_NAME=My WissKI
DRUPAL_TRUSTED_HOST=localhost
DRUPAL_USER=admin

# WissKI settings
# For a full list of WissKI recipe versions see: https://packagist.org/packages/soda-collection-objects-data-literacy/wisski_recipe_base
WISSKI_DEFAULT_DATA_MODEL_VERSION=1.x-dev
WISSKI_DEFAULT_GRAPH=https://my.wiss-ki.eu/
WISSKI_STARTER_VERSION=1.x-dev

# RDF4J settings
RDF4J_PORT=8983

# SOLR settings
SOLR_PORT=8983

# Redis settings
REDIS_HOST=redis
REDIS_PORT=6379

# Varnish settings
VARNISH_HOST=varnish
VARNISH_PORT=8000
VARNISH_IMAGE_VERSION=1.0.0

# TS settings
TS_PASSWORD=ts_password
TS_REPOSITORY=default # has to be "default" for now
TS_TOKEN=ts_token
TS_USERNAME=ts_user
